{
  "name": "maru-iken",
  "version": "1.1.0",
  "private": true,
  "description": "同じ意見があつまると丸が大きくなる、クラス意見アプリ",
  "scripts": {
    "dev": "npx wrangler@latest pages dev",
    "deploy": "npx wrangler@latest pages deploy",
    "db:local": "npx wrangler@latest d1 execute maru-iken --local --file=./schema.sql",
    "db:remote": "npx wrangler@latest d1 execute maru-iken --remote --file=./schema.sql"
  },
  "type": "module",
  "devDependencies": {
    "wrangler": "^4.136.2"
  }
}
